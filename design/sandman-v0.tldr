    },
    {
      "id": "shape:f7poFqi4gRyfTR5MjqyqO",
      "index": "b06Sij",
      "isLocked": false,
      "meta": {},
      "opacity": 1,
      "parentId": "page:page",
      "props": {
        "autoSize": true,
        "color": "black",
        "font": "sans",
        "richText": {
          "content": [
            {
              "content": [
                {
                  "text": "~/.sandman/",
                  "type": "text"
                }
              ],
              "type": "paragraph"
            },
            {
              "content": [
                {
                  "text": "├── archive/",
                  "type": "text"
                }
              ],
              "type": "paragraph"
            },
            {
              "content": [
                {
                  "text": "│   └── claude/<yyyy>-<mm>-<dd>-<ts>-<orig relpath>   bytes at rest — take's target",
                  "type": "text"
                }
              ],
              "type": "paragraph"
            },
            {
              "content": [
                {
                  "text": "├── log/",
                  "type": "text"
                }
              ],
              "type": "paragraph"
            },
            {
              "content": [
                {
                  "text": "│   ├── <date>.md          reflect's day pages",
                  "type": "text"
                }
              ],
              "type": "paragraph"
            },
            {
              "content": [
                {
                  "text": "│   └── INDEX.md           chronological index",
                  "type": "text"
                }
              ],
              "type": "paragraph"
            },
            {
              "content": [
                {
                  "text": "└── memories/",
                  "type": "text"
                }
              ],
              "type": "paragraph"
            },
            {
              "content": [
                {
                  "text": "    ├── .recent/<sid>.json    pointers — short-term (3 days)",
                  "type": "text"
                }
              ],
              "type": "paragraph"
            },
            {
              "content": [
                {
                  "text": "    └── <bank>/",
                  "type": "text"
                }
              ],
              "type": "paragraph"
            },
            {
              "content": [
                {
                  "text": "        ├── <type>_<slug>.md   one memory per file",
                  "type": "text"
                }
              ],
              "type": "paragraph"
            },
            {
              "content": [
                {
                  "text": "        ├── MEMORY.md          the index — regenerated",
                  "type": "text"
                }
              ],
              "type": "paragraph"
            },
            {
              "content": [
                {
                  "text": "        ├── _archive/          superseded — never rm'd",
                  "type": "text"
                }
              ],
              "type": "paragraph"
            },
            {
              "content": [
                {
                  "text": "        └── _reflect.json      {at, count, last_ops}",
                  "type": "text"
                }
              ],
              "type": "paragraph"
            }
          ],
          "type": "doc"
        },
        "scale": 0.875,
        "size": "s",
        "textAlign": "start",
        "w": 638.99609375
      },
      "rotation": 0,
      "type": "text",

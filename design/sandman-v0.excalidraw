    },
    {
      "id": "t-f-dream-b",
      "type": "text",
      "x": 1588.6637368084296,
      "y": 1845.6886562790914,
      "width": 295.49692479266946,
      "height": 118.12500000000003,
      "text": "voyage log \u2014 the day page: one md per day\n  from the chronological lane \u00b7 INDEX.md tail\nbank upkeep when grown (+5 AND \u226520 h):\n  ONE call, whole bank in, \u22646 ops out,\n  net-non-increasing \u2014 merge \u00b7 rewrite \u00b7 archive\nprune + regen each bank's MEMORY.md (\u2264180)\nnightly 23:30 \u2014 reflect IS the :major pass",
      "fontSize": 12.5,
      "fontFamily": 6,
      "strokeColor": "#1e1e1e",
      "seed": 96158,
      "version": 367,
      "versionNonce": 1905421743,
      "isDeleted": false,
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
      "backgroundColor": "transparent",
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "boundElements": [],
      "updated": 1786018008267,
      "link": null,
      "locked": false,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "voyage log \u2014 the day page: one md per day\n  from the chronological lane \u00b7 INDEX.md tail\nbank upkeep when grown (+5 AND \u226520 h):\n  ONE call, whole bank in, \u22646 ops out,\n  net-non-increasing \u2014 merge \u00b7 rewrite \u00b7 archive\nprune + regen each bank's MEMORY.md (\u2264180)\nnightly 23:30 \u2014 reflect IS the :major pass",
      "autoResize": false,
      "lineHeight": 1.3500000000000003,
      "index": "b00"
    },
    {
      "id": "t-f-note",
      "type": "text",
      "x": 94.66373680842958,
      "y": 2081.6886562790914,
      "width": 1103.0616455078125,
      "height": 35.1,
      "text": "forget never enters this flow \u2014 /delete destroys every copy before take could see it.\ncommit_memory stays the single format authority: dream (routing) and reflect (upkeep) both write through it.",
      "fontSize": 13,
      "fontFamily": 6,
      "strokeColor": "#1e1e1e",
      "seed": 17441,
      "version": 409,
      "versionNonce": 2035796161,
      "isDeleted": false,

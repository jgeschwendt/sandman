    {
      "id": "t-f-pass-b",
      "type": "text",
      "x": 1218.6637368084296,
      "y": 1845.6886562790914,
      "width": 294.34727150610416,
      "height": 101.25000000000003,
      "text": "memories/.recent in \u2014 banks out\nsonnet \u00b7 opus \u00b7 fable dream in parallel\nmemory-blind \u00b7 each proposes \u00b7 no veto\n2-of-3 consensus \u2014 matched by claim\nstrongest agreeing tier carries the wording\ncommit_memory under .commit.lock",
      "fontSize": 12.5,
      "fontFamily": 6,
      "strokeColor": "#1e1e1e",

        "richText": {
          "content": [
            {
              "content": [
                {
                  "text": "2026-09-02 · three jobs killed a minute apart → three debts. The only drains that ran were",
                  "type": "text"
                }
              ],
              "type": "paragraph"
            },
            {
              "content": [
                {
                  "text": "the next two kills' hooks, each inside the 120 s window: a kill appends a queue-operation",
                  "type": "text"
                }
              ],
              "type": "paragraph"
            },
            {
              "content": [
                {
                  "text": "line to the transcript at the instant SessionEnd fires, so the transcript is always fresh",
                  "type": "text"
                }
              ],
              "type": "paragraph"
            },
            {
              "content": [
                {
                  "text": "at hook time. No ending followed; the debts sat until an unrelated one. The alarm closes",
                  "type": "text"
                }
              ],
              "type": "paragraph"
            },
            {
              "content": [
                {
                  "text": "the gap.",
                  "type": "text"
                }
              ],
              "type": "paragraph"
            }
          ],
          "type": "doc"
        },

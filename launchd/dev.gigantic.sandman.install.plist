<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>dev.gigantic.sandman.install</string>
  <!-- launchd/install every fifteen minutes: a clean trunk built and installed
       with its sandbox files and routines (docs/bank-format.html#shifts-sandbox).
       A template like the report agent's: `sandman plist install` renders it
       with the home spelled out. -->
  <key>ProgramArguments</key>
  <array>
    <string>/bin/sh</string>
    <string>{{HOME}}/.local/share/sandman/install</string>
  </array>
  <key>RunAtLoad</key><true/>
  <key>StartInterval</key><integer>900</integer>
  <key>StandardOutPath</key><string>{{HOME}}/Library/Logs/dev.gigantic.sandman.install.log</string>
  <key>StandardErrorPath</key><string>{{HOME}}/Library/Logs/dev.gigantic.sandman.install.log</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>HOME</key><string>{{HOME}}</string>
    <key>PATH</key><string>{{HOME}}/.local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>
</dict>
</plist>

<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>dev.gigantic.sandman.breathe</string>
  <!-- `sandman breathe tick` hourly at :17: close the ended passes' sessions,
       then open a skim and, once a New York day from 06:00, a deep pass
       (docs/bank-format.html#breath). PATH carries ~/.local/bin, where
       `dispatch` and `claude` live. A template like the others:
       `sandman setup` renders it with the home spelled out. -->
  <key>ProgramArguments</key>
  <array>
    <string>{{HOME}}/.local/bin/sandman</string>
    <string>breathe</string>
    <string>tick</string>
  </array>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Minute</key><integer>17</integer>
  </dict>
  <key>StandardOutPath</key><string>{{HOME}}/Library/Logs/dev.gigantic.sandman.breathe.log</string>
  <key>StandardErrorPath</key><string>{{HOME}}/Library/Logs/dev.gigantic.sandman.breathe.log</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>HOME</key><string>{{HOME}}</string>
    <key>PATH</key><string>{{HOME}}/.local/bin:/usr/bin:/bin</string>
  </dict>
</dict>
</plist>

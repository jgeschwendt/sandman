<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>dev.gigantic.sandman.reflect</string>
  <!-- `sandman reflect` nightly at 23:30 local, after the UTC day it writes
       has ended in every season: the 24 h pass and its backfill
       (docs/bank-format.html#log-rules). PATH carries ~/.local/bin, where the
       log and upkeep minds' `claude` lives. A template like the others:
       `sandman plist reflect` renders it with the home spelled out. -->
  <key>ProgramArguments</key>
  <array>
    <string>{{HOME}}/.local/bin/sandman</string>
    <string>reflect</string>
  </array>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key><integer>23</integer>
    <key>Minute</key><integer>30</integer>
  </dict>
  <key>StandardOutPath</key><string>{{HOME}}/Library/Logs/dev.gigantic.sandman.reflect.log</string>
  <key>StandardErrorPath</key><string>{{HOME}}/Library/Logs/dev.gigantic.sandman.reflect.log</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>HOME</key><string>{{HOME}}</string>
    <key>PATH</key><string>{{HOME}}/.local/bin:/usr/bin:/bin</string>
  </dict>
</dict>
</plist>

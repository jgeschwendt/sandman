<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>dev.gigantic.sandman.report</string>
  <!-- `sandman report serve` on 127.0.0.1:1705: the nights' reports and the
       proposals awaiting an answer (docs/bank-format.html#report). launchd
       expands no `~`, so this is a template: `sandman setup` renders
       it with the home spelled out and $SANDMAN_SHIFT_NIGHT carried over. -->
  <key>ProgramArguments</key>
  <array>
    <string>{{HOME}}/.local/bin/sandman</string>
    <string>report</string><string>serve</string>
  </array>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ThrottleInterval</key><integer>30</integer>
  <key>StandardOutPath</key><string>{{HOME}}/Library/Logs/dev.gigantic.sandman.report.log</string>
  <key>StandardErrorPath</key><string>{{HOME}}/Library/Logs/dev.gigantic.sandman.report.log</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>HOME</key><string>{{HOME}}</string>
    <key>PATH</key><string>{{HOME}}/.local/bin:/usr/bin:/bin</string>{{EXTRA_ENV}}
  </dict>
</dict>
</plist>

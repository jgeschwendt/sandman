#!/bin/sh
# Runs one test command under shift-test.sb, the sandbox a shift's tests get in place of
# Claude Code's, which the session profile excludes this wrapper from
# (docs/BANK-FORMAT.md § shifts, The sandbox). The proxy and agent variables go: the
# profile has no network, and nothing should go looking for one. The home comes from the
# user database, never $HOME, which a caller could point anywhere. `--log <path>` (under
# the working tree or $TMPDIR) gets a copy of stdout and stderr, so the call needs no
# pipe or redirect — either keeps it inside Claude Code's sandbox, where Seatbelt cannot nest.
# Install: install -m755 profiles/shift-test ~/.local/bin/ &&
#   install -m644 profiles/shift-test.sb ~/.local/share/sandman/
usage() { echo "shift-test: usage: shift-test [--log <path>] <test command> [args…]" >&2; exit 2; }
log=
[ "$1" != --log ] || { [ $# -gt 2 ] || usage; log=$2; shift 2; }
[ $# -gt 0 ] || usage
eval "home=~$(id -un)"
cwd=$(pwd -P)
case "$cwd/" in "$home/.grove/code/"?*) ;; *) echo "shift-test: $cwd is not under ~/.grove/code" >&2; exit 2 ;; esac
sandbox-exec -p '(version 1) (allow default)' /usr/bin/true 2>/dev/null || {
  echo "shift-test: still inside the session sandbox — make it the whole Bash call: no pipe, redirect, cd, && or \$(…) around it" >&2
  exit 71
}
profile="$(dirname "$0")/shift-test.sb"
[ -f "$profile" ] || profile="$home/.local/share/sandman/shift-test.sb"
run() {
  sandbox-exec -D HOME="$home" -D CWD="$cwd" -f "$profile" \
    env -u ALL_PROXY -u HTTPS_PROXY -u HTTP_PROXY -u SSH_AUTH_SOCK -u all_proxy -u https_proxy -u http_proxy \
    CARGO_NET_OFFLINE=true HEX_OFFLINE=1 HOME="$home" MIX_ENV=test "$@"
}
[ -n "$log" ] || { run "$@"; exit; }
dir=$(cd "$(dirname "$log")" 2>/dev/null && pwd -P)
tmp=$(cd "${TMPDIR:-/tmp}" && pwd -P)
case "$dir/" in "$cwd/"* | "$tmp/"*) ;; *) echo "shift-test: --log $log is not under $cwd or \$TMPDIR" >&2; exit 2 ;; esac
log="$dir/$(basename "$log")"
# This sh opens the log outside both sandboxes: a link there would write wherever it points,
# so a symlink or special file is refused, and the file is made afresh, never reopened.
[ ! -L "$log" ] && { [ ! -e "$log" ] || { [ -f "$log" ] && rm "$log"; }; } || {
  echo "shift-test: --log $log is a symlink or not a regular file" >&2
  exit 2
}
set -C
exec 3>"$log"
run "$@" >&3 2>&1
rc=$?
cat "$log"
exit $rc

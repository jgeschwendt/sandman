{
  "disabledMcpjsonServers": ["stele"],
  "permissions": {
    "additionalDirectories": ["~/.grove/code", "~/.routines", "~/.sandman"],
    "allow": [
      "Agent",
      "Bash",
      "Edit",
      "Glob",
      "Grep",
      "Read",
      "Skill",
      "TaskCreate",
      "TaskList",
      "TaskUpdate",
      "WebFetch",
      "WebSearch",
      "Write",
      "mcp__docket__list",
      "mcp__docket__open",
      "mcp__docket__reply",
      "mcp__docket__resolve",
      "mcp__docket__show",
      "mcp__docket__wait",
      "mcp__sandman__banks",
      "mcp__sandman__recall",
      "mcp__sandman__remember"
    ],
    "deny": [
      "Bash(git checkout -- *)",
      "Bash(git clean*)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git reset*)",
      "Bash(git stash*)",
      "Bash(pkill -f*)",
      "Bash(shift-test *)"
    ]
  },
  "sandbox": {
    "allowUnsandboxedCommands": false,
    "enabled": true,
    "excludedCommands": [
      "{{HOME}}/.local/bin/shift-test *",
      "git fetch *",
      "git pull *",
      "git push *",
      "grove sync *",
      "~/.local/bin/shift-test *"
    ],
    "filesystem": {
      "allowWrite": [
        "~/.bun",
        "~/.cache",
        "~/.cargo",
        "~/.docket",
        "~/.grove",
        "~/.hex",
        "~/.local/state/claude",
        "~/.local/state/mise",
        "~/.mix",
        "~/.routines",
        "~/.sandman",
        "~/Library/Caches"
      ],
      "denyRead": ["~/.aws", "~/.netrc", "~/.npmrc", "~/.ssh", "~/Codes"],
      "denyWrite": [
        "~/.bun/bin",
        "~/.cargo/bin",
        "~/.cargo/config",
        "~/.cargo/config.toml",
        "~/.mix/archives",
        "~/.mix/escripts"
      ]
    },
    "network": {
      "allowedDomains": [
        "127.0.0.1:1701",
        "127.0.0.1:1703",
        "127.0.0.1:7777",
        "api.anthropic.com",
        "api.github.com",
        "api.typesafe.ai",
        "builds.hex.pm",
        "export.arxiv.org",
        "github.com",
        "hacker-news.firebaseio.com",
        "index.crates.io",
        "news.ycombinator.com",
        "objects.githubusercontent.com",
        "raw.githubusercontent.com",
        "registry.npmjs.org",
        "repo.hex.pm",
        "static.crates.io",
        "vercel.com",
        "www.anthropic.com"
      ]
    }
  }
}
